{
  "Function": {
    "prefix": "FUNCTION",
    "body": [
      "FUNCTION ${1:Name}(${2}) AS ${3:VOID}",
      "\t$0",
      "END FUNCTION"
    ],
    "description": "FUNCTION … END FUNCTION"
  },
  "While": {
    "prefix": "WHILE",
    "body": [
      "WHILE ${1:condition}",
      "\t$0",
      "END WHILE"
    ],
    "description": "WHILE … END WHILE"
  },
  "If": {
    "prefix": "IF",
    "body": [
      "IF ${1:condition} THEN",
      "\t$0",
      "END IF"
    ],
    "description": "IF … END IF"
  },
  "For": {
    "prefix": "FOR",
    "body": [
      "FOR ${1:i} = ${2:0} TO ${3:n}",
      "\t$0",
      "END FOR"
    ],
    "description": "FOR … END FOR"
  },
  "Repeat": {
    "prefix": "REPEAT",
    "body": [
      "REPEAT",
      "\t$0",
      "UNTIL ${1:condition}"
    ],
    "description": "REPEAT … UNTIL"
  },
