{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?:PUBLIC|PRIVATE|PROTECTED|EXPORT|STATIC|OVERRIDE|ASYNC)\\s+)*(FUNCTION|WHILE|IF|FOR|CLASS|STRUCT|INTERFACE|CONSTRUCTOR|DESTRUCTOR|REPEAT)\\b",
      "end": "^\\s*(END\\s+(FUNCTION|WHILE|IF|FOR|CLASS|STRUCT|INTERFACE|CONSTRUCTOR|DESTRUCTOR)|UNTIL)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:PUBLIC|PRIVATE|PROTECTED|EXPORT|STATIC|OVERRIDE|ASYNC)\\s+)*(FUNCTION|WHILE|IF|ELSE|FOR|CLASS|STRUCT|INTERFACE|CONSTRUCTOR|DESTRUCTOR|REPEAT)\\b(?!.*\\b(END|UNTIL)\\b)(?!.*\\bTHEN\\b\\s+(?!//)\\S).*$",
    "decreaseIndentPattern": "^\\s*(END\\s+(FUNCTION|WHILE|IF|FOR|CLASS|STRUCT|INTERFACE|CONSTRUCTOR|DESTRUCTOR)|ELSE|UNTIL)\\b"
  }
}
